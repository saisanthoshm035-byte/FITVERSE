[TEMPLATE]
# FITVERSE environment configuration — copy real values into .env (local) or Render env vars.
# NEVER commit the real .env or real secrets.

# --- Optional: persistent remote database (recommended for Render) ---
# Create a free database at https://turso.tech, then paste its URL and token here.
# FITVERSE uses local SQLite unless remote mode is EXPLICITLY enabled: after
# setting the URL/token below, also set FITVERSE_DB_MODE=remote on the server.
# FITVERSE_DB_URL=libsql://your-db-yourorg.turso.io
# FITVERSE_DB_TOKEN=your-database-token
# FITVERSE_DB_MODE=remote

# --- Google sign-in (optional) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Groq AI (powers FITVERSE AI: coach chat, generators, insights, tips) ---
# Get a free key at https://console.groq.com — never commit the real key.
GROQ_API_KEY=
# Optional overrides (defaults: llama-3.3-70b-versatile / llama-3.1-8b-instant)
GROQ_MODEL=
GROQ_MODEL_FAST=

# --- Legacy AI coach LLM seam (optional; Groq above is preferred) ---
FITVERSE_LLM_API=
FITVERSE_LLM_KEY=
FITVERSE_LLM_MODEL=
